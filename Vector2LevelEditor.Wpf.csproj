<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>Vector2LevelEditor</AssemblyName>
    <RootNamespace>Vector2LevelEditor</RootNamespace>
    <Product>Vector 2 Level Editor Windows Port</Product>
    <Title>Vector 2 Level Editor Windows Port Alpha 3.6.13</Title>
    <Version>0.3.6.13-alpha</Version>
    <AssemblyVersion>0.3.6.13</AssemblyVersion>
    <FileVersion>0.3.6.13</FileVersion>
    <Vector2BundledAssetsRoot>$(MSBuildProjectDirectory)/ProjectAssets</Vector2BundledAssetsRoot>
  </PropertyGroup>
  <ItemGroup>
    <!-- Reserved for local throwaway verification projects; never compile their generated obj files into the editor. -->
    <Compile Remove="Verification\**\*.cs" />
    <Content Include="GameData\**\*.*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
    <Content Include="$(Vector2BundledAssetsRoot)/**/*.*">
      <Link>ProjectAssets/%(RecursiveDir)%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
    <Content Remove="$(Vector2BundledAssetsRoot)/Vector2/TextureBank/**/vector1_*.*" />
    <Content Remove="$(Vector2BundledAssetsRoot)/**/__MACOSX/**/*.*" />
    <Content Remove="$(Vector2BundledAssetsRoot)/**/._*" />
  </ItemGroup>
</Project>
