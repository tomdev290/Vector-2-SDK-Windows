<UserControl x:Class="Vector2LevelEditor.Views.RoomLayoutPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{DynamicResource MenuBrush}" Foreground="{DynamicResource WindowTextBrush}"
             Height="300">
  <Border BorderBrush="{DynamicResource ControlBorderBrush}" BorderThickness="0,1,0,0">
    <Grid>
      <Grid.RowDefinitions><RowDefinition Height="42"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <DockPanel Grid.Row="0" Margin="12,6">
        <Button DockPanel.Dock="Right" Content="&#xE8BB;" FontFamily="Segoe MDL2 Assets" Width="26" ToolTip="Close Room Layouts" Click="Close_Click" Margin="6,0,0,0"/>
        <Button DockPanel.Dock="Right" Content="Make Selection Shared" Click="MakeShared_Click" Padding="8,4" Margin="6,0,0,0"/>
        <Button DockPanel.Dock="Right" Content="Test All Layouts" Click="Validate_Click" Padding="8,4" Margin="6,0,0,0"/>
        <TextBlock Text="Room Layouts" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"/>
      </DockPanel>
      <Grid Grid.Row="1" Margin="10,0">
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <Grid Grid.Column="0" Margin="4,3,8,5">
          <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
          <TextBlock Text="START" FontSize="11" FontWeight="Bold" Foreground="#438CE7" Margin="0,0,0,5"/>
          <ListBox x:Name="StartOptions" Grid.Row="1" SelectionChanged="Options_SelectionChanged">
            <ListBox.ItemTemplate><DataTemplate><StackPanel Margin="4,2"><TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" FontSize="11"/><TextBlock Text="{Binding Nodes.Count, StringFormat={}{0} objects}" FontSize="10" Foreground="{DynamicResource MutedTextBrush}"/></StackPanel></DataTemplate></ListBox.ItemTemplate>
          </ListBox>
          <DockPanel Grid.Row="2" Margin="0,5,0,0">
            <Button DockPanel.Dock="Right" Content="&#xE710;" FontFamily="Segoe MDL2 Assets" ToolTip="Create Start layout from selected objects" Width="27" Click="CreateStart_Click"/>
            <TextBox x:Name="StartName" ToolTip="Start layout name" Margin="0,0,5,0"/>
          </DockPanel>
        </Grid>
        <Grid Grid.Column="1" Margin="4,3,8,5">
          <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
          <TextBlock Text="MIDDLE" FontSize="11" FontWeight="Bold" Foreground="#C77D27" Margin="0,0,0,5"/>
          <ListBox x:Name="MiddleOptions" Grid.Row="1" SelectionChanged="Options_SelectionChanged">
            <ListBox.ItemTemplate><DataTemplate><StackPanel Margin="4,2"><TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" FontSize="11"/><TextBlock Text="{Binding Nodes.Count, StringFormat={}{0} objects}" FontSize="10" Foreground="{DynamicResource MutedTextBrush}"/></StackPanel></DataTemplate></ListBox.ItemTemplate>
          </ListBox>
          <DockPanel Grid.Row="2" Margin="0,5,0,0">
            <Button DockPanel.Dock="Right" Content="&#xE710;" FontFamily="Segoe MDL2 Assets" ToolTip="Create Middle layout from selected objects" Width="27" Click="CreateMiddle_Click"/>
            <TextBox x:Name="MiddleName" ToolTip="Middle layout name" Margin="0,0,5,0"/>
          </DockPanel>
        </Grid>
        <Grid Grid.Column="2" Margin="4,3,4,5">
          <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
          <TextBlock Text="FINISH" FontSize="11" FontWeight="Bold" Foreground="#2D9760" Margin="0,0,0,5"/>
          <ListBox x:Name="FinishOptions" Grid.Row="1" SelectionChanged="Options_SelectionChanged">
            <ListBox.ItemTemplate><DataTemplate><StackPanel Margin="4,2"><TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" FontSize="11"/><TextBlock Text="{Binding Nodes.Count, StringFormat={}{0} objects}" FontSize="10" Foreground="{DynamicResource MutedTextBrush}"/></StackPanel></DataTemplate></ListBox.ItemTemplate>
          </ListBox>
          <DockPanel Grid.Row="2" Margin="0,5,0,0">
            <Button DockPanel.Dock="Right" Content="&#xE710;" FontFamily="Segoe MDL2 Assets" ToolTip="Create Finish layout from selected objects" Width="27" Click="CreateFinish_Click"/>
            <TextBox x:Name="FinishName" ToolTip="Finish layout name" Margin="0,0,5,0"/>
          </DockPanel>
        </Grid>
      </Grid>
      <Border Grid.Row="2" BorderBrush="{DynamicResource ControlBorderBrush}" BorderThickness="0,1,0,0" Padding="10,6">
        <StackPanel>
          <DockPanel Margin="0,0,0,5">
            <TextBlock x:Name="Status" DockPanel.Dock="Right" FontSize="10" Foreground="{DynamicResource MutedTextBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
            <TextBlock x:Name="SelectionTitle" FontWeight="SemiBold" FontSize="11" VerticalAlignment="Center"/>
          </DockPanel>
          <WrapPanel>
            <Button Content="Add Current Selection" Click="Assign_Click" Padding="7,3" Margin="0,0,6,3"/>
            <TextBox x:Name="RenameName" Width="100" ToolTip="Layout name" Margin="0,0,4,3"/>
            <Button Content="Rename" Click="Rename_Click" Padding="7,3" Margin="0,0,6,3"/>
            <ComboBox x:Name="ParentPicker" Width="130" DisplayMemberPath="DisplayName" ToolTip="Parent layout" Margin="0,0,4,3"/>
            <Button Content="Link" Click="Link_Click" Padding="7,3" Margin="0,0,6,3"/>
            <Button Content="Delete Layout" Click="Delete_Click" Padding="7,3" Margin="0,0,6,3"/>
          </WrapPanel>
        </StackPanel>
      </Border>
    </Grid>
  </Border>
</UserControl>
