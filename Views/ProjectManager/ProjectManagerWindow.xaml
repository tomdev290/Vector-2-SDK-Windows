<UserControl x:Class="Vector2LevelEditor.Views.ProjectManager.ProjectManagerWindow" x:Name="ProjectManagerRoot"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:studios="clr-namespace:Vector2LevelEditor.Views.ProjectManager.Studios"
        Background="{DynamicResource ProjectManagerWorkspaceBrush}" Foreground="{DynamicResource WindowTextBrush}"
        FontFamily="Segoe UI" UseLayoutRounding="True" SnapsToDevicePixels="True">
  <UserControl.Resources>
    <Style x:Key="SearchResultButton" TargetType="Button">
      <Setter Property="Foreground" Value="{DynamicResource WindowTextBrush}"/><Setter Property="Background" Value="Transparent"/>
      <Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
        <Border x:Name="Surface" Background="{TemplateBinding Background}" CornerRadius="7" Padding="{TemplateBinding Padding}">
          <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Center"/>
        </Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Background" Value="{DynamicResource ProjectManagerHoverBrush}"/></Trigger></ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="FlatButton" TargetType="Button">
      <Setter Property="Background" Value="Transparent"/><Setter Property="Foreground" Value="{DynamicResource WindowTextBrush}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource ProjectManagerEdgeBrush}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="13,7"/><Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="B" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="7" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="B" Property="Background" Value="{DynamicResource ProjectManagerHoverBrush}"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.38"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource FlatButton}"><Setter Property="Background"><Setter.Value><LinearGradientBrush StartPoint="0,0" EndPoint="1,0"><GradientStop Color="#4B97F5"/><GradientStop Color="#347CD9" Offset="1"/></LinearGradientBrush></Setter.Value></Setter><Setter Property="BorderThickness" Value="0"/><Setter Property="Foreground" Value="White"/><Setter Property="FontWeight" Value="SemiBold"/></Style>
    <Style x:Key="NavItem" TargetType="ListBoxItem">
      <Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Margin" Value="7,1"/><Setter Property="Padding" Value="10,6"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><Border x:Name="B" CornerRadius="6" Background="Transparent" Padding="{TemplateBinding Padding}"><ContentPresenter/></Border><ControlTemplate.Triggers><Trigger Property="IsSelected" Value="True"><Setter TargetName="B" Property="Background" Value="#4B97F5"/><Setter Property="Foreground" Value="White"/></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="B" Property="Background" Value="{DynamicResource ProjectManagerHoverBrush}"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style TargetType="TextBox"><Setter Property="Background" Value="{DynamicResource ProjectManagerFieldBrush}"/><Setter Property="Foreground" Value="{DynamicResource WindowTextBrush}"/><Setter Property="CaretBrush" Value="{DynamicResource WindowTextBrush}"/><Setter Property="BorderBrush" Value="{DynamicResource ProjectManagerEdgeBrush}"/><Setter Property="Padding" Value="10,7"/></Style>
    <Style TargetType="DataGrid"><Setter Property="Background" Value="{DynamicResource ProjectManagerCardBrush}"/><Setter Property="RowBackground" Value="{DynamicResource ProjectManagerCardBrush}"/><Setter Property="AlternatingRowBackground" Value="{DynamicResource ProjectManagerFieldBrush}"/><Setter Property="Foreground" Value="{DynamicResource WindowTextBrush}"/><Setter Property="BorderThickness" Value="0"/><Setter Property="GridLinesVisibility" Value="Horizontal"/><Setter Property="HorizontalGridLinesBrush" Value="{DynamicResource ProjectManagerEdgeBrush}"/><Setter Property="HeadersVisibility" Value="Column"/><Setter Property="RowHeight" Value="38"/></Style>
    <Style TargetType="DataGridRow"><Setter Property="Background" Value="{DynamicResource ProjectManagerCardBrush}"/><Setter Property="Foreground" Value="{DynamicResource WindowTextBrush}"/></Style>
    <Style TargetType="DataGridCell"><Setter Property="Background" Value="Transparent"/><Setter Property="Foreground" Value="{DynamicResource WindowTextBrush}"/><Setter Property="BorderBrush" Value="{DynamicResource ProjectManagerEdgeBrush}"/></Style>
  </UserControl.Resources>

  <Grid>
    <Grid.ColumnDefinitions><ColumnDefinition Width="174"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>

    <Border Grid.Column="0" Background="{DynamicResource ProjectManagerSidebarBrush}" BorderBrush="{DynamicResource ProjectManagerEdgeBrush}" BorderThickness="0,0,1,0">
      <DockPanel>
        <StackPanel DockPanel.Dock="Top" Margin="16,20,12,14">
          <TextBlock Text="Vector 2 Editor" FontSize="16" FontWeight="Bold"/>
          <TextBlock Text="Project Manager" FontSize="11" Foreground="{DynamicResource ProjectManagerMutedBrush}" Margin="0,2,0,8"/>
        </StackPanel>
        <StackPanel DockPanel.Dock="Bottom" Margin="18,8,18,14">
          <Separator Background="{DynamicResource ProjectManagerEdgeBrush}" Margin="0,4,0,12"/>
          <TextBlock Text="Rooms, chapters, and game content." FontSize="11" Foreground="{DynamicResource ProjectManagerMutedBrush}" TextWrapping="Wrap"/>
          <StackPanel Orientation="Horizontal" Margin="0,12,0,0"><Ellipse Width="8" Height="8" Fill="#35B86B" VerticalAlignment="Center"/><TextBlock Text="{Binding Project.Name, TargetNullValue=No project open}" FontSize="12" FontWeight="Bold" Margin="8,0,0,0" TextTrimming="CharacterEllipsis"/></StackPanel>
          <TextBlock Text="{Binding ProjectPath}" Foreground="{DynamicResource ProjectManagerMutedBrush}" FontSize="10" TextWrapping="Wrap" MaxHeight="30" Margin="16,3,0,7"/>
          <StackPanel Orientation="Horizontal"><Button Content="New…" Command="{Binding NewProjectCommand}" Style="{StaticResource FlatButton}" BorderThickness="0"/><Button Content="Open…" Command="{Binding OpenProjectCommand}" Style="{StaticResource FlatButton}" BorderThickness="0"/></StackPanel>
        </StackPanel>
        <ListBox ItemsSource="{Binding Sections}" SelectedItem="{Binding SelectedSection}" Background="Transparent" BorderThickness="0" ItemContainerStyle="{StaticResource NavItem}" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
          <ListBox.ItemTemplate><DataTemplate><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="22"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="{Binding Icon}" FontFamily="Segoe MDL2 Assets" FontSize="12" VerticalAlignment="Center"/><TextBlock Grid.Column="1" Text="{Binding DisplayName}" FontSize="12" FontWeight="Medium" VerticalAlignment="Center"/></Grid></DataTemplate></ListBox.ItemTemplate>
        </ListBox>
      </DockPanel>
    </Border>

    <Grid Grid.Column="1">
      <Grid.RowDefinitions><RowDefinition Height="46"/><RowDefinition Height="*"/><RowDefinition Height="24"/></Grid.RowDefinitions>
      <Border Background="{DynamicResource ProjectManagerTopBarBrush}" BorderBrush="{DynamicResource ProjectManagerEdgeBrush}" BorderThickness="0,0,0,1" Padding="24,5">
        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
          <Border x:Name="SearchFieldBorder" Grid.Column="1" Background="{DynamicResource ProjectManagerFieldBrush}" CornerRadius="8" Height="36">
            <Border.Style>
              <Style TargetType="Border">
                <Setter Property="BorderBrush" Value="{DynamicResource ProjectManagerEdgeBrush}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Style.Triggers>
                  <DataTrigger Binding="{Binding SearchFocused}" Value="True">
                    <Setter Property="BorderBrush" Value="#438CE7"/>
                    <Setter Property="BorderThickness" Value="2"/>
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </Border.Style>
            <DockPanel>
              <TextBlock Text="&#xE721;" FontFamily="Segoe MDL2 Assets" Margin="13,0,8,0" VerticalAlignment="Center" Foreground="{DynamicResource ProjectManagerMutedBrush}"/>
              <Button DockPanel.Dock="Right" Content="Done" Visibility="{Binding SearchFocusVisibility}" Click="DoneSearch_Click" Background="Transparent" BorderThickness="0" Width="44" FontSize="11"/>
              <Button DockPanel.Dock="Right" Content="&#xE8BB;" FontFamily="Segoe MDL2 Assets" Visibility="{Binding SearchResultsVisibility}" Click="ClearSearch_Click" ToolTip="Clear search" Width="30" Background="Transparent" BorderThickness="0"/>
              <Grid>
                <TextBox x:Name="SearchField" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" BorderThickness="0" Background="Transparent" Padding="8,0" VerticalContentAlignment="Center" ToolTip="Search every project tab and file" GotKeyboardFocus="SearchField_GotKeyboardFocus"/>
                <TextBlock Text="Search every project tab and file" Visibility="{Binding SearchPlaceholderVisibility}" IsHitTestVisible="False" Foreground="{DynamicResource ProjectManagerMutedBrush}" FontSize="11" Margin="10,0,0,0" VerticalAlignment="Center"/>
              </Grid>
            </DockPanel>
          </Border>
          <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Install Changes" Command="{Binding InstallCommand}" Style="{StaticResource PrimaryButton}" Margin="0,0,8,0"/>
            <Button Command="{Binding RefreshCommand}" Style="{StaticResource FlatButton}" BorderThickness="0" ToolTip="Refresh"><TextBlock Text="&#xE72C;" FontFamily="Segoe MDL2 Assets" FontSize="16"/></Button>
          </StackPanel>
        </Grid>
      </Border>

      <Grid Grid.Row="1">
        <Border x:Name="SearchResultsPanel" Panel.ZIndex="90" Visibility="{Binding SearchResultsVisibility}" HorizontalAlignment="Center" VerticalAlignment="Top" Width="610" MaxHeight="440" Margin="0,4,0,0" Background="{DynamicResource ProjectManagerCardBrush}" BorderBrush="{DynamicResource ProjectManagerEdgeBrush}" BorderThickness="1" CornerRadius="13" Padding="6">
          <Border.RenderTransform><TransformGroup><ScaleTransform ScaleX="1" ScaleY="1"/><TranslateTransform/></TransformGroup></Border.RenderTransform>
          <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>
            <TextBlock Visibility="{Binding NoSearchResultsVisibility}" Foreground="{DynamicResource ProjectManagerMutedBrush}" Margin="14" FontSize="12"><Run Text="Nothing in this project matches "/><Run Text="{Binding SearchText, Mode=OneWay}"/></TextBlock>
            <ItemsControl ItemsSource="{Binding SearchHits}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Button Command="{Binding DataContext.OpenSearchHitCommand, ElementName=ProjectManagerRoot}" CommandParameter="{Binding}" HorizontalContentAlignment="Stretch" Padding="12,9" BorderThickness="0" Style="{StaticResource SearchResultButton}" Margin="0,0,0,2">
                    <Grid>
                      <Grid.ColumnDefinitions><ColumnDefinition Width="26"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="20"/></Grid.ColumnDefinitions>
                      <TextBlock Grid.Column="0" Text="{Binding Icon}" FontFamily="Segoe MDL2 Assets" FontSize="15" Foreground="#438CE7" VerticalAlignment="Center"/>
                      <StackPanel Grid.Column="1">
                        <TextBlock Text="{Binding Title}" FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{Binding Detail}" FontSize="10" Foreground="{DynamicResource ProjectManagerMutedBrush}" TextTrimming="CharacterEllipsis"/>
                      </StackPanel>
                      <TextBlock Grid.Column="2" Text="{Binding Section}" FontSize="10" Foreground="{DynamicResource ProjectManagerMutedBrush}" Margin="12,0" VerticalAlignment="Center"/>
                      <TextBlock Grid.Column="3" Text="&#xE72A;" FontFamily="Segoe MDL2 Assets" Foreground="{DynamicResource ProjectManagerMutedBrush}" VerticalAlignment="Center"/>
                    </Grid>
                  </Button>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            </StackPanel>
          </ScrollViewer>
        </Border>
        <Grid Visibility="{Binding WelcomeVisibility}">
          <Border Width="610" Padding="32" HorizontalAlignment="Center" VerticalAlignment="Center" Background="{DynamicResource ProjectManagerCardBrush}" BorderBrush="{DynamicResource ProjectManagerEdgeBrush}" BorderThickness="1" CornerRadius="15">
            <StackPanel>
              <Border Width="64" Height="64" CornerRadius="18" Background="#438CE7" HorizontalAlignment="Center"><TextBlock Text="&#xE8B7;" FontFamily="Segoe MDL2 Assets" FontSize="31" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
              <TextBlock Text="Give your mod its own workspace" FontSize="24" FontWeight="Bold" TextAlignment="Center" Margin="0,18,0,8"/>
              <TextBlock Text="Create a new project folder for rooms, chapters, story, game systems, media, and installable custom content." TextAlignment="Center" TextWrapping="Wrap" Foreground="{DynamicResource ProjectManagerMutedBrush}" FontSize="14"/>
              <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,22,0,0"><Button Content="New Project…" Command="{Binding NewProjectCommand}" Style="{StaticResource PrimaryButton}" Margin="0,0,8,0"/><Button Content="Open Existing Project…" Command="{Binding OpenProjectCommand}" Style="{StaticResource FlatButton}"/></StackPanel>
            </StackPanel>
          </Border>
        </Grid>

        <ScrollViewer Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
          <StackPanel Margin="24,14,24,24" MaxWidth="1290" HorizontalAlignment="Stretch">
            <Grid Margin="0,0,0,18"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Project Overview" FontSize="30" FontWeight="Bold"/><TextBlock Text="Everything in your mod, organized and ready for Vector 2." Foreground="{DynamicResource ProjectManagerMutedBrush}" FontSize="16" Margin="0,4,0,0"/></StackPanel><Button Grid.Column="1" Content="Export Project" Command="{Binding ExportCommand}" Style="{StaticResource FlatButton}" VerticalAlignment="Center"/></Grid>
            <Border Background="{DynamicResource ProjectManagerCardBrush}" BorderBrush="{DynamicResource ProjectManagerEdgeBrush}" BorderThickness="1" CornerRadius="15" Padding="0" Margin="0,0,0,14">
              <Grid Height="190"><Grid.ColumnDefinitions><ColumnDefinition Width="310"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Border Background="{DynamicResource ProjectManagerArtworkBrush}" CornerRadius="14,0,0,14"><StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"><TextBlock Text="&#xEB9F;" FontFamily="Segoe MDL2 Assets" FontSize="52" Foreground="{DynamicResource ProjectManagerMutedBrush}" HorizontalAlignment="Center"/><TextBlock Text="PROJECT ARTWORK" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource ProjectManagerMutedBrush}" Margin="0,12,0,0"/></StackPanel></Border>
                <StackPanel Grid.Column="1" Margin="25,20"><StackPanel Orientation="Horizontal"><TextBlock Text="{Binding Project.Name}" FontSize="25" FontWeight="Bold"/><Border Background="#183D2A" CornerRadius="10" Padding="11,6" Margin="12,0,0,0"><TextBlock Text="ACTIVE PROJECT" Foreground="#57D487" FontSize="10" FontWeight="Bold"/></Border></StackPanel><TextBlock Text="{Binding Project.Description, TargetNullValue=No project description yet.}" Foreground="{DynamicResource ProjectManagerMutedBrush}" FontSize="15" TextWrapping="Wrap" Margin="0,8,0,18" MaxHeight="42"/><TextBlock Text="{Binding ProjectPath}" FontSize="11" Foreground="{DynamicResource ProjectManagerMutedBrush}" TextTrimming="CharacterEllipsis"/></StackPanel>
              </Grid>
            </Border>
            <UniformGrid Columns="4" Margin="0,0,0,20">
              <Border Background="{DynamicResource ProjectManagerCardBrush}" BorderBrush="{DynamicResource ProjectManagerEdgeBrush}" BorderThickness="1" CornerRadius="10" Padding="14" Margin="0,0,10,0"><StackPanel><TextBlock Text="FILES" Foreground="{DynamicResource ProjectManagerMutedBrush}" FontSize="11" FontWeight="Bold"/><TextBlock Text="{Binding TotalFiles}" FontSize="22" FontWeight="SemiBold"/></StackPanel></Border>
              <Border Background="{DynamicResource ProjectManagerCardBrush}" BorderBrush="{DynamicResource ProjectManagerEdgeBrush}" BorderThickness="1" CornerRadius="10" Padding="14" Margin="0,0,10,0"><StackPanel><TextBlock Text="ROOMS" Foreground="{DynamicResource ProjectManagerMutedBrush}" FontSize="11" FontWeight="Bold"/><TextBlock Text="{Binding RoomCount}" FontSize="22" FontWeight="SemiBold"/></StackPanel></Border>
              <Border Background="{DynamicResource ProjectManagerCardBrush}" BorderBrush="{DynamicResource ProjectManagerEdgeBrush}" BorderThickness="1" CornerRadius="10" Padding="14" Margin="0,0,10,0"><StackPanel><TextBlock Text="ZONES" Foreground="{DynamicResource ProjectManagerMutedBrush}" FontSize="11" FontWeight="Bold"/><TextBlock Text="{Binding ZoneCount}" FontSize="22" FontWeight="SemiBold"/></StackPanel></Border>
              <Border Background="{DynamicResource ProjectManagerCardBrush}" BorderBrush="{DynamicResource ProjectManagerEdgeBrush}" BorderThickness="1" CornerRadius="10" Padding="14"><StackPanel><TextBlock Text="CONTENT TYPES" Foreground="{DynamicResource ProjectManagerMutedBrush}" FontSize="11" FontWeight="Bold"/><TextBlock Text="{Binding ContentTypeCount}" FontSize="22" FontWeight="SemiBold"/></StackPanel></Border>
            </UniformGrid>
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="3*"/><ColumnDefinition Width="2*"/></Grid.ColumnDefinitions>
              <Border Background="{DynamicResource ProjectManagerCardBrush}" CornerRadius="15" BorderBrush="{DynamicResource ProjectManagerEdgeBrush}" BorderThickness="1" Padding="20" Margin="0,0,12,0"><StackPanel><TextBlock Text="Project Settings" FontSize="18" FontWeight="Bold" Margin="0,0,0,14"/><TextBlock Text="Name" Foreground="{DynamicResource MutedTextBrush}"/><TextBox Text="{Binding Project.Name, UpdateSourceTrigger=PropertyChanged}"/><Grid Margin="0,10"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="12"/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Author" Foreground="{DynamicResource MutedTextBrush}"/><TextBox Text="{Binding Project.Author, UpdateSourceTrigger=PropertyChanged}"/></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="Version" Foreground="{DynamicResource MutedTextBrush}"/><TextBox Text="{Binding Project.Version, UpdateSourceTrigger=PropertyChanged}"/></StackPanel></Grid><TextBlock Text="Description" Foreground="{DynamicResource MutedTextBrush}"/><TextBox Text="{Binding Project.Description, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" Height="78" TextWrapping="Wrap"/><CheckBox Content="Generate debug inventory when exporting" IsChecked="{Binding Project.GenerateDebugData}" Margin="0,12"/><Button Content="Save Project Settings" Command="{Binding SaveProjectCommand}" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left"/></StackPanel></Border>
              <StackPanel Grid.Column="1"><Border Background="{DynamicResource ProjectManagerCardBrush}" CornerRadius="15" BorderBrush="{DynamicResource ProjectManagerEdgeBrush}" BorderThickness="1" Padding="20" Margin="0,0,0,12"><StackPanel><TextBlock Text="Game Connection" FontSize="18" FontWeight="Bold"/><TextBlock Text="{Binding GameStatus}" Foreground="{DynamicResource MutedTextBrush}" Margin="0,5,0,12"/><Button Content="Choose Vector 2_Data" Command="{Binding ConnectGameCommand}" Style="{StaticResource FlatButton}" HorizontalAlignment="Left"/></StackPanel></Border><Border Background="{DynamicResource ProjectManagerCardBrush}" CornerRadius="15" BorderBrush="{DynamicResource ProjectManagerEdgeBrush}" BorderThickness="1" Padding="20"><StackPanel><TextBlock Text="Validation" FontSize="18" FontWeight="Bold"/><TextBlock Text="{Binding ValidationSummary}" Margin="0,5,0,12"/><Button Content="Run Project Checks" Command="{Binding ValidateCommand}" Style="{StaticResource FlatButton}" HorizontalAlignment="Left"/><ItemsControl ItemsSource="{Binding ValidationIssues}" Margin="0,10,0,0"><ItemsControl.ItemTemplate><DataTemplate><TextBlock Text="{Binding Message}" TextWrapping="Wrap" Foreground="#E26D6D" Margin="0,3"/></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel></Border></StackPanel>
            </Grid>
          </StackPanel>
        </ScrollViewer>

        <studios:ProjectOverviewView Visibility="{Binding OverviewVisibility}"/>

        <Grid Visibility="{Binding BrowserVisibility}" Margin="26">
          <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
          <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="52"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Border Width="52" Height="52" CornerRadius="15" Background="#438CE7"><TextBlock Text="{Binding SelectedSection.Icon}" FontFamily="Segoe MDL2 Assets" FontSize="25" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center"><TextBlock Text="{Binding SectionTitle}" FontSize="30" FontWeight="Bold"/><TextBlock Text="{Binding SectionDescription}" FontSize="15" Foreground="{DynamicResource ProjectManagerMutedBrush}"/></StackPanel><StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center"><Button Content="Import Files…" Command="{Binding ImportCommand}" Style="{StaticResource PrimaryButton}" Margin="0,0,8,0"/><Button Content="Open Folder" Command="{Binding OpenFolderCommand}" Style="{StaticResource FlatButton}"/></StackPanel></Grid>
          <Border Grid.Row="1" Visibility="{Binding CreationVisibility}" Background="{DynamicResource ProjectManagerCardBrush}" BorderBrush="{DynamicResource ProjectManagerEdgeBrush}" BorderThickness="1" CornerRadius="15" Padding="12" Margin="0,18,0,12"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox Text="{Binding NewItemName, UpdateSourceTrigger=PropertyChanged}" ToolTip="New item name"/><Button Grid.Column="1" Content="Create New…" Command="{Binding CreateItemCommand}" Style="{StaticResource PrimaryButton}" Margin="10,0,0,0"/></Grid></Border>
          <Border Grid.Row="2" Background="{DynamicResource ProjectManagerCardBrush}" BorderBrush="{DynamicResource ProjectManagerEdgeBrush}" BorderThickness="1" CornerRadius="15" Padding="8"><DataGrid ItemsSource="{Binding FilteredFiles}" SelectedItem="{Binding SelectedFile}" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single">
            <DataGrid.Columns><DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="2*"/><DataGridTextColumn Header="Type" Binding="{Binding Extension}" Width="90"/><DataGridTextColumn Header="Location" Binding="{Binding RelativePath}" Width="3*"/><DataGridTextColumn Header="Size" Binding="{Binding SizeText}" Width="90"/><DataGridTextColumn Header="Modified" Binding="{Binding Modified}" Width="155"/><DataGridTemplateColumn Header="Actions" Width="210"><DataGridTemplateColumn.CellTemplate><DataTemplate><StackPanel Orientation="Horizontal"><Button Content="Open" Command="{Binding DataContext.OpenFileCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" Style="{StaticResource FlatButton}"/><Button Content="Reveal" Command="{Binding DataContext.RevealCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" Style="{StaticResource FlatButton}"/><Button Content="Delete" Command="{Binding DataContext.DeleteCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" Style="{StaticResource FlatButton}" Foreground="#E26D6D"/></StackPanel></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn></DataGrid.Columns>
          </DataGrid></Border>
        </Grid>

        <studios:ProjectStudioHost x:Name="StudioHost" Visibility="{Binding StudioVisibility}"/>

        <Grid Visibility="{Binding EditorVisibility}" Margin="26">
          <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
          <Grid Margin="0,0,0,18"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal"><Border Width="52" Height="52" CornerRadius="15" Background="#438CE7"><TextBlock Text="&#xE943;" FontFamily="Segoe MDL2 Assets" FontSize="24" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><StackPanel Margin="14,0,0,0" VerticalAlignment="Center"><TextBlock Text="{Binding EditorTitle}" FontSize="28" FontWeight="Bold"/><TextBlock Text="Project XML · validated before saving" Foreground="{DynamicResource ProjectManagerMutedBrush}"/></StackPanel></StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"><Button Content="Back" Command="{Binding CloseEditorCommand}" Style="{StaticResource FlatButton}" Margin="0,0,8,0"/><Button Content="Validate &amp; Save" Command="{Binding SaveEditorCommand}" Style="{StaticResource PrimaryButton}"/></StackPanel>
          </Grid>
          <Border Grid.Row="1" Background="{DynamicResource ProjectManagerCardBrush}" BorderBrush="{DynamicResource ProjectManagerEdgeBrush}" BorderThickness="1" CornerRadius="15" Padding="14">
            <TextBox Text="{Binding EditorText, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" AcceptsTab="True" FontFamily="Cascadia Mono,Consolas" FontSize="13" TextWrapping="NoWrap" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" SpellCheck.IsEnabled="False"/>
          </Border>
        </Grid>
      </Grid>
      <Border Grid.Row="2" Background="{DynamicResource ProjectManagerTopBarBrush}" BorderBrush="{DynamicResource ProjectManagerEdgeBrush}" BorderThickness="0,1,0,0" Padding="13,0"><StackPanel Orientation="Horizontal"><Ellipse Width="7" Height="7" Fill="#35B86B" VerticalAlignment="Center"/><TextBlock Text="{Binding Status}" FontSize="11" Foreground="{DynamicResource ProjectManagerMutedBrush}" VerticalAlignment="Center" Margin="8,0,0,0" TextTrimming="CharacterEllipsis"/></StackPanel></Border>
    </Grid>
  </Grid>
</UserControl>
