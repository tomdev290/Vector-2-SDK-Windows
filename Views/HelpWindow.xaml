<Window x:Class="Vector2LevelEditor.Views.HelpWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Vector 2 Editor Help" Width="760" Height="680"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource PanelBrush}" Foreground="{DynamicResource WindowTextBrush}">
  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="26">
      <TextBlock Text="Vector 2 Editor Help" FontSize="26" FontWeight="Bold"/>
      <TextBlock Text="Keyboard bindings and tool rail guide" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource MutedTextBrush}" Margin="0,4,0,20"/>

      <TextBlock Text="Keyboard" FontSize="17" FontWeight="Bold" Margin="0,0,0,10"/>
      <Grid Margin="0,0,0,22">
        <Grid.ColumnDefinitions><ColumnDefinition Width="190"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <Grid.Resources>
          <Style TargetType="TextBlock"><Setter Property="Margin" Value="0,5"/><Setter Property="TextWrapping" Value="Wrap"/></Style>
        </Grid.Resources>
        <Grid.RowDefinitions>
          <RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/>
        </Grid.RowDefinitions>
        <TextBlock Grid.Row="0" Text="1-9" FontWeight="Bold"/><TextBlock Grid.Row="0" Grid.Column="1" Text="Switch tools on the left rail"/>
        <TextBlock Grid.Row="1" Text="Hold Q + scroll" FontWeight="Bold"/><TextBlock Grid.Row="1" Grid.Column="1" Text="Cycle through left-rail tools"/>
        <TextBlock Grid.Row="2" Text="Hold V + drag" FontWeight="Bold"/><TextBlock Grid.Row="2" Grid.Column="1" Text="Corner/edge snap against nearby objects"/>
        <TextBlock Grid.Row="3" Text="Hold U + drag" FontWeight="Bold"/><TextBlock Grid.Row="3" Grid.Column="1" Text="Middle-handle snap against nearby objects"/>
        <TextBlock Grid.Row="4" Text="Hold T + drag" FontWeight="Bold"/><TextBlock Grid.Row="4" Grid.Column="1" Text="Lock movement horizontally"/>
        <TextBlock Grid.Row="5" Text="Hold G + drag" FontWeight="Bold"/><TextBlock Grid.Row="5" Grid.Column="1" Text="Lock movement vertically"/>
        <TextBlock Grid.Row="6" Text="Hold Y in Trapezoid tool" FontWeight="Bold"/><TextBlock Grid.Row="6" Grid.Column="1" Text="Place Type 2 trapezoid"/>
        <TextBlock Grid.Row="7" Text="Shift + drag" FontWeight="Bold"/><TextBlock Grid.Row="7" Grid.Column="1" Text="Marquee add-select on canvas"/>
        <TextBlock Grid.Row="8" Text="Shift in hierarchy" FontWeight="Bold"/><TextBlock Grid.Row="8" Grid.Column="1" Text="Select a subtree or a Photoshop-style row range"/>
        <TextBlock Grid.Row="9" Text="Ctrl+C / Ctrl+V" FontWeight="Bold"/><TextBlock Grid.Row="9" Grid.Column="1" Text="Copy and paste selected object"/>
        <TextBlock Grid.Row="10" Text="Delete" FontWeight="Bold"/><TextBlock Grid.Row="10" Grid.Column="1" Text="Delete selected object"/>
        <TextBlock Grid.Row="11" Text="Ctrl+Z / Ctrl+Shift+Z" FontWeight="Bold"/><TextBlock Grid.Row="11" Grid.Column="1" Text="Undo / redo"/>
      </Grid>

      <TextBlock Text="Tool rail" FontSize="17" FontWeight="Bold" Margin="0,0,0,10"/>
      <ItemsControl ItemsSource="{Binding ToolGuides}" Margin="0,0,0,22">
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Grid Margin="0,2">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="38"/>
                <ColumnDefinition Width="125"/>
                <ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>
              <Border Width="30" Height="30"
                      Background="{DynamicResource ToolRailBrush}"
                      BorderBrush="{DynamicResource ControlBorderBrush}"
                      BorderThickness="1">
                <Grid Width="22" Height="22">
                  <Viewbox Visibility="{Binding Tool.IconVisibility}" Stretch="Uniform">
                    <Path Data="{Binding Tool.IconData}"
                          Fill="{DynamicResource WindowTextBrush}"
                          Stroke="{DynamicResource WindowTextBrush}"
                          StrokeThickness="1.7"
                          StrokeStartLineCap="Square"
                          StrokeEndLineCap="Square"
                          StrokeLineJoin="Miter"/>
                  </Viewbox>
                  <TextBlock Text="{Binding Tool.Glyph}"
                             Visibility="{Binding Tool.TextVisibility}"
                             FontSize="12"
                             FontWeight="Bold"
                             HorizontalAlignment="Center"
                             VerticalAlignment="Center"/>
                </Grid>
              </Border>
              <TextBlock Grid.Column="1"
                         Text="{Binding Tool.Label}"
                         FontWeight="SemiBold"
                         VerticalAlignment="Center"
                         Margin="8,0"/>
              <TextBlock Grid.Column="2"
                         Text="{Binding Description}"
                         TextWrapping="Wrap"
                         VerticalAlignment="Center"/>
            </Grid>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>

      <TextBlock Text="Dynamic Studio" FontSize="17" FontWeight="Bold" Margin="0,0,0,8"/>
      <TextBlock Text="Frames use the game's 60 FPS timeline, so 60 frames is about one second. Select an object, open Dynamic Studio, add keyframes, choose movement/resize/rotation easing, preview, then save. Only properties changed by the timeline are exported. Movement modes include Bezier, sine ease in/out, Fast-Slow-Fast, and Backtrack then Finish. Rotation includes linear, cubic, and smooth ease modes."
                 TextWrapping="Wrap" LineHeight="20" Margin="0,0,0,18"/>
      <Button Content="Close" Click="Close_Click" HorizontalAlignment="Right" Background="{DynamicResource ToolButtonBrush}" Padding="18,6"/>
    </StackPanel>
  </ScrollViewer>
</Window>
