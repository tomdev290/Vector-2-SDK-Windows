<UserControl x:Class="Vector2LevelEditor.Views.AIStudioView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Vector2LevelEditor.Controls"
             Background="{DynamicResource PanelBrush}"
             Foreground="{DynamicResource WindowTextBrush}">
  <Grid x:Name="RootLayout">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="290"/>
      <ColumnDefinition Width="*"/>
      <ColumnDefinition Width="330"/>
    </Grid.ColumnDefinitions>

    <Grid Grid.Column="0" Background="{DynamicResource MenuBrush}">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
        <RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>
      <DockPanel Margin="16,16,16,12">
        <Button DockPanel.Dock="Right" Content="&#xE710;" FontFamily="Segoe MDL2 Assets" Width="30" Height="30" ToolTip="Add AI" Click="AddCharacter_Click"/>
        <StackPanel>
          <TextBlock Text="AI DESIGNER" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource MutedTextBrush}"/>
          <TextBlock Text="{Binding Document.Name}" FontSize="18" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
        </StackPanel>
      </DockPanel>
      <ListBox x:Name="Characters" Grid.Row="1" Margin="12,0" BorderThickness="0" Background="Transparent" SelectionChanged="Characters_SelectionChanged">
        <ListBox.ItemTemplate>
          <DataTemplate>
            <StackPanel Margin="8,6">
              <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold"/>
              <TextBlock FontSize="10" Foreground="{DynamicResource MutedTextBrush}">
                <Run Text="AI "/><Run Text="{Binding AIChannel}"/><Run Text="  ·  "/><Run Text="{Binding Kind}"/>
              </TextBlock>
            </StackPanel>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
      <Grid Grid.Row="2" Margin="16,10,16,16" Height="208">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="66"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <DockPanel Margin="0,0,0,5">
          <Button DockPanel.Dock="Right" Content="&#xE710;" FontFamily="Segoe MDL2 Assets" Width="24" ToolTip="Add group" Click="AddGroup_Click"/>
          <TextBlock Text="GROUPS" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource MutedTextBrush}" VerticalAlignment="Center"/>
        </DockPanel>
        <ListBox x:Name="Groups" Grid.Row="1" BorderThickness="0" Background="Transparent" DisplayMemberPath="Name" SelectionChanged="Groups_SelectionChanged"/>
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
          <StackPanel x:Name="GroupMembers"/>
        </ScrollViewer>
      </Grid>
    </Grid>

    <Grid Grid.Column="1">
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <StackPanel Margin="24,20,24,12">
        <TextBlock x:Name="PreviewTitle" Text="Create an AI" FontSize="25" FontWeight="SemiBold" HorizontalAlignment="Center"/>
        <TextBlock Text="LIVE MODEL PREVIEW" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource MutedTextBrush}" HorizontalAlignment="Center"/>
      </StackPanel>
      <Grid Grid.Row="1" Margin="22,0,22,0">
        <controls:TrickPreviewControl x:Name="Preview" ShowDebugEdges="False" ShowModelOutlines="False" ShowModelNodePoints="False" CenterOnVisibleModel="True"/>
        <TextBlock x:Name="PreviewMessage" Foreground="#C5CDD9" TextAlignment="Center" TextWrapping="Wrap" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="260"/>
      </Grid>
      <DockPanel Grid.Row="2" Margin="24,12,24,18">
        <TextBlock Text="Preview zoom" FontSize="11" VerticalAlignment="Center" Foreground="{DynamicResource MutedTextBrush}"/>
        <Slider x:Name="ZoomSlider" Minimum="0.75" Maximum="8" Value="3.5" Width="170" Margin="12,0" VerticalAlignment="Center" ValueChanged="ZoomSlider_ValueChanged"/>
        <Button Content="Reset" Click="ResetZoom_Click" Width="54"/>
      </DockPanel>
    </Grid>

    <Border Grid.Column="2" BorderBrush="{DynamicResource ControlBorderBrush}" BorderThickness="1,0,0,0" Background="{DynamicResource MenuBrush}">
      <Grid>
      <TextBlock x:Name="NoCharacterMessage" Text="Add an AI to configure it." HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource MutedTextBrush}"/>
      <ScrollViewer x:Name="ConfigurationScroll" VerticalScrollBarVisibility="Auto">
        <StackPanel x:Name="Configuration" Margin="16,18,16,24">
          <TextBlock Text="CHARACTER" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource MutedTextBrush}" Margin="0,0,0,12"/>
          <TextBlock Text="Name" FontSize="11" Margin="0,0,0,3"/>
          <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,10"/>
          <TextBlock Text="Type" FontSize="11" Margin="0,0,0,3"/>
          <ComboBox x:Name="KindPicker" SelectedItem="{Binding Kind, Mode=TwoWay}" Margin="0,0,0,10"/>
          <TextBlock Text="AI channel" FontSize="11" Margin="0,0,0,3"/>
          <TextBox Text="{Binding AIChannel, Mode=TwoWay, UpdateSourceTrigger=LostFocus, ValidatesOnExceptions=True}" Margin="0,0,0,16"/>
          <TextBlock Text="SPAWN" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource MutedTextBrush}" Margin="0,0,0,9"/>
          <TextBlock Text="Spawn name" FontSize="11" Margin="0,0,0,3"/>
          <TextBox Text="{Binding BirthSpawn, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,10"/>
          <TextBlock Text="Start delay (seconds)" FontSize="11" Margin="0,0,0,3"/>
          <TextBox Text="{Binding StartDelay, Mode=TwoWay, UpdateSourceTrigger=LostFocus, ValidatesOnExceptions=True}" Margin="0,0,0,10"/>
          <CheckBox Content="Spawn on start" IsChecked="{Binding SpawnOnStart}" Margin="0,0,0,18"/>
          <TextBlock Text="MODEL STACK" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource MutedTextBrush}" Margin="0,0,0,9"/>
          <TextBlock Text="Body" FontSize="11" Margin="0,0,0,3"/>
          <ComboBox x:Name="BodyPicker" SelectedValue="{Binding BodySkin, Mode=TwoWay}" SelectedValuePath="Filename" DisplayMemberPath="DisplayName" Margin="0,0,0,10"/>
          <TextBlock Text="Chest" FontSize="11" Margin="0,0,0,3"/>
          <ComboBox x:Name="ChestPicker" SelectedValue="{Binding ChestSkin, Mode=TwoWay}" SelectedValuePath="Filename" DisplayMemberPath="DisplayName" Margin="0,0,0,10"/>
          <TextBlock Text="Helmet" FontSize="11" Margin="0,0,0,3"/>
          <ComboBox x:Name="HelmetPicker" SelectedValue="{Binding HelmetSkin, Mode=TwoWay}" SelectedValuePath="Filename" DisplayMemberPath="DisplayName" Margin="0,0,0,10"/>
          <TextBlock Text="Hair" FontSize="11" Margin="0,0,0,3"/>
          <ComboBox x:Name="HairPicker" SelectedValue="{Binding HairSkin, Mode=TwoWay}" SelectedValuePath="Filename" DisplayMemberPath="DisplayName" Margin="0,0,0,18"/>
          <TextBlock Text="CUSTOM MODEL LAYERS" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource MutedTextBrush}" Margin="0,0,0,9"/>
          <StackPanel x:Name="AvailableCustomLayers" Margin="0,0,0,10"/>
          <ListBox x:Name="CustomLayers" Height="76" Margin="0,0,0,6"/>
          <DockPanel Margin="0,0,0,18">
            <Button DockPanel.Dock="Right" Content="Add" Width="46" Click="AddLayer_Click"/>
            <TextBox x:Name="NewLayerName" Margin="0,0,6,0" ToolTip="Model XML filename"/>
          </DockPanel>
          <Button Content="Remove selected layer" Click="RemoveLayer_Click" Margin="0,0,0,18"/>
          <Button Content="Delete AI" Click="DeleteCharacter_Click" HorizontalAlignment="Left"/>
          <Button Content="Save Room XML" Click="SaveRoom_Click" Margin="0,22,0,0"/>
        </StackPanel>
      </ScrollViewer>
      </Grid>
    </Border>
  </Grid>
</UserControl>
